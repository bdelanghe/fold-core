{
  "about": "fold-core one-id vectors (DESIGN-one-id-path-version-component-2026-10-30). Outputs are recomputed from inputs by tests/ids.rs; FOLD_BLESS=1 rewrites them.",
  "base": "https://ipso.bounded.tools/",
  "rules": {
    "slug": "lowercase (Unicode), keep [a-z0-9_.-], each run of anything else becomes one '-', trim '-' from both ends, keep the first 60 chars, 'x' if empty",
    "quiddity": "the node's own 'kind' (slugged) if a non-blank string, else by the key it is listed under: sections -> section, groups -> group, items/kids/children -> item; the document root is 'page'",
    "step": "kind[slug(id)] when the node has a non-blank 'id'; else kind[slug(raw name)]~h, h = first 8 hex of sha256(UTF-8 of parent + '\\n' + kind + '\\n' + raw name + '\\n' + distinguishing)",
    "raw_name": "first non-blank (trimmed) of title, nav, name, action, label, text; '' if none",
    "distinguishing": "first non-blank (trimmed) of link.href, href, text, summary, purpose, why, action; '' if none",
    "path": "steps joined by '/'; the root's path is ''; a group with no title is layout only and adds no step",
    "haecceity": "base + slug(source) for the root; base + slug(source) + '/' + path with '[' -> %5B and ']' -> %5D otherwise",
    "html_id": "the path as it stands in the haecceity (%5B/%5D); the root's is slug(source)",
    "unique": "one canonical path per thing: two nodes with the same path fail the build"
  },
