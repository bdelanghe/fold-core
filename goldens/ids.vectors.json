{
  "about": "fold-core one-id vectors (DESIGN-one-id-path-version-component-2026-10-30). Outputs are recomputed from inputs by tests/ids.rs; FOLD_BLESS=1 rewrites them. Supersedes sha 0779111e (slugged role[name] steps), which must not be pinned.",
  "base": "https://ipso.bounded.tools/",
  "rules": {
    "segment": "a source id as one path segment: its UTF-8 bytes, each byte outside [A-Za-z0-9._-] as %XX (uppercase hex); never slugged or case-folded. '/', '~', '#', '[' and ']' in an id are all encoded",
    "source_id": "the node's 'id' if a non-blank string (trimmed of whitespace at both ends) or a JSON number (as written); otherwise none",
    "quiddity": "the node's own 'kind' (slugged) if a non-blank string, else by the key it is listed under: sections -> section, groups -> group, items/kids/children -> item; the document root is 'page'. The quiddity is metadata (data-quiddity), never part of the haecceity",
    "step": "segment(source id) when the node has one; else the opaque token '~' + first 16 hex of sha256(UTF-8 of parent + '\\n' + kind + '\\n' + raw name + '\\n' + distinguishing), marked provisional",
    "raw_name": "first non-blank (trimmed) of title, nav, name, action, label, text; '' if none",
    "distinguishing": "first non-blank (trimmed) of link.href, href, text, summary, purpose, why, action; '' if none",
    "path": "steps joined by '/'; the root's path is ''; a group with no title is layout only and adds no step",
    "haecceity": "base + segment(source) for the root; base + segment(source) + '/' + path otherwise (segments are already encoded)",
    "html_id": "the path as it stands in the haecceity; the root's is segment(source)",
    "selector": "role[name] (Allie's address, the rotor's) is a selector that resolves to a haecceity, never part of one",
    "unique": "one canonical path per thing: two nodes with the same path fail the build",
    "named_by": "how a segment was named, never a bare boolean: 'source-id' (the data's own id) or 'provisional-token' (fold-core's stopgap; it hashes a label, so a label fix changes it; never published to facto or signed; the fix is a source id in the data, or a facto-minted id). The root reads 'source-id' (its source)"
  },
